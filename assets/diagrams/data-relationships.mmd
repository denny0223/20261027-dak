config:
  theme: base
  look: classic
  htmlLabels: false
  themeVariables:
    fontFamily: 'Noto Sans CJK TC, Noto Sans, sans-serif'
    fontSize: 28px
    primaryColor: '#ffffff'
    primaryTextColor: '#1e1e1e'
    primaryBorderColor: '#5f6368'
    lineColor: '#5f6368'
